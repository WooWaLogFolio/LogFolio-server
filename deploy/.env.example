# 이미지: 실제 배포에서는 GitHub Actions가 커밋 SHA를 IMAGE_TAG에 넣습니다.
BACKEND_IMAGE=ghcr.io/woowalogfolio/logfolio-backend
AI_IMAGE=ghcr.io/woowalogfolio/logfolio-ai
IMAGE_TAG=replace-with-git-sha

# TLS
ACME_EMAIL=admin@logfolio.kr

# PostgreSQL
POSTGRES_DB=logfolio
POSTGRES_USER=logfolio
POSTGRES_PASSWORD=replace-with-a-strong-password

# Frontend / OAuth
CORS_ALLOWED_ORIGINS=https://www.logfolio.kr,https://logfolio.kr
OAUTH2_SUCCESS_REDIRECT_URI=https://www.logfolio.kr/oauth2/success
OAUTH2_SIGNUP_REDIRECT_URI=https://www.logfolio.kr/oauth2/complete-signup

NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=

# Spring ↔ AI 공통 내부 인증키
AI_SERVER_INTERNAL_API_KEY=replace-with-a-long-random-secret

# Gemini
GEMINI_API_KEY=
GEMINI_MODEL=replace-with-a-validated-production-model

# AI request timeouts. Two Gemini attempts can occur for one analysis request.
AI_LLM_TIMEOUT_SECONDS=45
AI_ANALYSIS_TIMEOUT_SECONDS=110
AI_SERVER_READ_TIMEOUT=120s
